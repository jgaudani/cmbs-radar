# Copy to .env (never commit it) and fill in. Keep the single quotes: the
# password hash contains "$" characters that must not be expanded.

# Public hostname; its DNS A record must point at the VM before Caddy starts
# (README step 2). Without a domain, use <public-ip>.sslip.io instead.
SITE_ADDRESS='cmbs.jaygaudani.com'

# One shared login for the demo. Make the hash on the VM with:
#   docker run --rm caddy:2 caddy hash-password --plaintext 'your-password'
BASIC_AUTH_USER='newmark'
BASIC_AUTH_HASH='$2a$14$replace-with-the-output-of-caddy-hash-password'

# Database password (letters and digits only; it goes into a URL):
#   openssl rand -hex 16
POSTGRES_PASSWORD='replace-me'

# Claude briefs. Leave empty and set API_FLAGS='--no-briefs' to turn them off.
ANTHROPIC_API_KEY=''
API_FLAGS=''
